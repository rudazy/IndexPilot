# SoSoValue Open API key. Required for /api/prices (market snapshots) and
# /api/signals (ETF flows + momentum). Get one at https://sosovalue.com
SOSOVALUE_API_KEY=

# Anthropic API key for the AI briefing panel (/api/briefing).
ANTHROPIC_API_KEY=

# --- SoDEX execution (server-side signing) ---------------------------------
# Private key of the API wallet registered with SoDEX. Signs EIP-712 trading
# actions server-side. NEVER commit a real key.
SODEX_SIGNER_PRIVATE_KEY=

# Name of the registered SoDEX API key (the X-API-Key header value).
# Must match ^[0-9a-zA-Z_-]{1,36}$ and must not be "default".
SODEX_API_KEY_NAME=

# Optional: numeric SoDEX account id override. When unset, the account is
# resolved from SODEX_ACCOUNT_ADDRESS (or the signer's address).
SODEX_ACCOUNT_ID=

# Optional: address whose SoDEX account is traded/read. Defaults to the
# signer's address.
SODEX_ACCOUNT_ADDRESS=

# "mainnet" (default) or "testnet". Mainnet places REAL orders.
SODEX_NETWORK=testnet

# WalletConnect / Reown project id for RainbowKit wallet connections.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
